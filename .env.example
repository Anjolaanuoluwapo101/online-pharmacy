# Copy to `.env` and fill in your own values, then restart the dev server.
# `.env` is git-ignored — never commit real keys.

# Groq — https://console.groq.com/keys
VITE_GROQ_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# GitHub PAT with `gist` read/write scope — https://github.com/settings/tokens
VITE_GITHUB_PAT=

# Gist ids (from the gist URLs: https://gist.github.com/<user>/<id>)
VITE_GIST_MEDPLUS=
VITE_GIST_ALPHA=
VITE_GIST_PATIENTS=
VITE_GIST_ORDERS=
